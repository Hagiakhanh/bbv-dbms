@DBMS.API_HostAddress = http://localhost:5272

### ===================================================================
### 1. DATABASE APIs (FULL CRUD)
### ===================================================================

### 1.1 Get all databases
GET {{DBMS.API_HostAddress}}/api/Databases
Accept: application/json

###

### 1.2 Create a new database
POST {{DBMS.API_HostAddress}}/api/Databases
Content-Type: application/json

{
  "name": "SalesDb",
  "owner": "sa"
}

###

### 1.3 Get database by name
GET {{DBMS.API_HostAddress}}/api/Databases/SalesDb
Accept: application/json

###

### 1.4 Rename or update database
PATCH {{DBMS.API_HostAddress}}/api/Databases/SalesDb
Content-Type: application/json

{
  "newName": "SalesDb_V2",
  "newOwner": "admin"
}

###

### 1.5 Delete database
DELETE {{DBMS.API_HostAddress}}/api/Databases/SalesDb_V2

###

### ===================================================================
### 2. SCHEMA APIs (FULL CRUD)
### ===================================================================

### 2.1 List all schemas (default: master database)
GET {{DBMS.API_HostAddress}}/api/Schemas?databaseName=master
Accept: application/json

###

### 2.2 Create a new schema 'public' in 'master' database
POST {{DBMS.API_HostAddress}}/api/Schemas
Content-Type: application/json

{
  "databaseName": "master",
  "name": "public",
  "owner": "dbo"
}

###

### 2.3 Get schema details by name
GET {{DBMS.API_HostAddress}}/api/Schemas/public
Accept: application/json

###

### 2.4 Rename schema 'public' to 'sales_public'
PATCH {{DBMS.API_HostAddress}}/api/Schemas/public
Content-Type: application/json

{
  "newName": "sales_public"
}

###

### 2.5 Delete schema 'sales_public'
DELETE {{DBMS.API_HostAddress}}/api/Schemas/sales_public

###

### ===================================================================
### 3. COLUMN APIs (FULL CRUD - NESTED UNDER TABLE)
### ===================================================================

### 3.1 List all columns in table 'Users'
GET {{DBMS.API_HostAddress}}/api/tables/Users/columns
Accept: application/json

###

### 3.2 Add a new column 'Email' to table 'Users'
POST {{DBMS.API_HostAddress}}/api/tables/Users/columns
Content-Type: application/json

{
  "name": "Email",
  "dataType": "VARCHAR",
  "isNullable": true,
  "defaultValue": ""
}

###

### 3.3 Get details of column 'Email' in table 'Users'
GET {{DBMS.API_HostAddress}}/api/tables/Users/columns/Email
Accept: application/json

###

### 3.4 Update column 'Email' (rename to 'UserEmail') in table 'Users'
PATCH {{DBMS.API_HostAddress}}/api/tables/Users/columns/Email
Content-Type: application/json

{
  "newName": "UserEmail",
  "dataType": "VARCHAR",
  "isNullable": true
}

###

### 3.5 Delete column 'UserEmail' from table 'Users'
DELETE {{DBMS.API_HostAddress}}/api/tables/Users/columns/UserEmail

###

### ===================================================================
### 4. CATALOG & METADATA APIs
### ===================================================================

### 4.1 Get Catalog Tree
GET {{DBMS.API_HostAddress}}/api/catalog/tree?database=master&depth=4
Accept: application/json

###

### 4.2 Get Database Metadata
GET {{DBMS.API_HostAddress}}/api/catalog/databases/master
Accept: application/json

###

### 4.3 Get Schema Metadata
GET {{DBMS.API_HostAddress}}/api/catalog/schemas/dbo?db=master
Accept: application/json

###

### 4.4 Get Table Metadata
GET {{DBMS.API_HostAddress}}/api/catalog/tables/Users?schema=dbo&db=master
Accept: application/json

###

